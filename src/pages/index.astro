---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InfoStrip from '../components/InfoStrip.astro';
import MenuLinks from '../components/MenuLinks.astro';
import Gallery from '../components/Gallery.astro';
import MapCTA from '../components/MapCTA.astro';
import Footer from '../components/Footer.astro';
import InfoFAQ from '../components/InfoFAQ.astro';
import NoticePopup from '../components/NoticePopup.astro';
import { notice } from '../lib/data';
---
<BaseLayout>
  {notice.enabled && <NoticePopup />}
  <Header />
  <Hero />
  <InfoStrip />
  {/* menu 페이지 숨김에 맞춰 메뉴 카드도 숨김(복구 시 주석 해제): <MenuLinks /> */}
  <Gallery />
  <MapCTA />
  <InfoFAQ />
  <Footer />
</BaseLayout>
