---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMenu, languages, type MenuLocale } from '../lib/menu';
interface Props { locale: MenuLocale }
const { locale } = Astro.props;
const language = languages.find(language => language.code === locale)!;
const { copy, sections, options, decafPrice, formatPrice } = getMenu(locale);
---
<BaseLayout title={copy.title} description={copy.description} lang={language.tag}>
  <Fragment slot="head">
    {languages.map(language => <link rel="alternate" hreflang={language.tag} href={'https://marketmay.com' + language.href} />)}
    <link rel="alternate" hreflang="x-default" href="https://marketmay.com/menu/" />
  </Fragment>
  <main class={`menu-page menu-page-${locale}`}>
    <header class="menu-header">
      <h1 class="menu-title" aria-label={copy.title}>
        <a href="/" aria-label={locale === 'ko' ? '마켓메이 홈페이지로 이동' : 'Go to MARKET MAY homepage'}>
          <img src="/images/market-may-menu-logo.png" alt="MARKET MAY" width="1800" height="400" />
        </a>
      </h1>
      <nav class="language-nav" aria-label={copy.languageLabel}>
        {languages.map(language => (
          <a href={language.href} lang={language.tag} hreflang={language.tag} aria-current={language.code === locale ? 'page' : undefined}>{language.label}</a>
        ))}
      </nav>
    </header>
    <p class="menu-tagline">{copy.menuTagline}</p>
    <nav class="menu-nav" aria-label={copy.navLabel}>
      {sections.map(section => <a href={'#' + section.id} aria-label={section.name}>{section.nav}</a>)}
    </nav>
    {sections.map(section => (
      <section class="menu-section" id={section.id} aria-labelledby={'heading-' + section.id}>
        <h2 id={'heading-' + section.id}>{section.name}</h2>
        {section.note && <p class="section-note">{section.note}</p>}
        {section.id === 'coffee' && decafPrice !== undefined && (
          <p class="decaf-note">{copy.decaf} · <strong>{decafPrice === 0 ? copy.freeChange : '+' + formatPrice(decafPrice)}</strong></p>
        )}
        <ul>
          {section.items.map(item => (
            <li class={item.isNew ? 'featured-item' : undefined} data-menu-id={item.id}>
              <div class="menu-row">
                <h3>{item.name}{item.isNew && <span class="new-badge">{copy.newLabel}</span>}</h3>
                <span class="price">{formatPrice(item.price)}</span>
              </div>
              {item.hotOnly && <p class="temperature"><span>{copy.hotOnly}</span></p>}
              {item.detail && <p class="detail">{item.detail}</p>}
            </li>
          ))}
        </ul>
        {section.id === 'coffee' && (
          <div class="coffee-options" id="options" aria-labelledby="options-heading">
            <h3 id="options-heading">{copy.optionsTitle}</h3>
            <dl>{options.map(option => (
              <div class="option">
                <dt>{option.name}</dt>
                <dd class="price">{option.price === 0 ? copy.free : (option.refill ? '' : '+') + formatPrice(option.price)}</dd>
                {option.detail && <dd class="detail">{option.detail}</dd>}
              </div>
            ))}</dl>
          </div>
        )}
      </section>
    ))}
  </main>
</BaseLayout>

<script>
  const menuLinks = [...document.querySelectorAll<HTMLAnchorElement>('.menu-nav a')];
  const menuSections = menuLinks
    .map(link => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);
  let scheduled = false;
  function updateCurrentSection() {
    let current = menuSections[0]?.id;
    for (const section of menuSections) {
      if (section.getBoundingClientRect().top <= 110) current = section.id;
    }
    for (const link of menuLinks) {
      if (link.hash.slice(1) === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    scheduled = false;
  }
  function scheduleUpdate() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateCurrentSection);
  }
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('hashchange', scheduleUpdate);
  updateCurrentSection();
</script>

<style>
  @font-face {
    font-family: 'Spoqa Han Sans Neo';
    src: url('/fonts/SpoqaHanSansNeo-Regular.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Spoqa Han Sans Neo';
    src: url('/fonts/SpoqaHanSansNeo-Bold.woff2') format('woff2');
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }
  :global(body) { background: #f4f3ee; color: #1e2823; }
  .menu-page { max-width: 50rem; min-height: 100vh; margin: 0 auto; padding: 32px clamp(24px, 5vw, 44px) 72px; background: #fff; box-shadow: 0 12px 48px #243b2f0d; }
  .menu-page-ko { font-family: 'Spoqa Han Sans Neo', 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif; }
  .menu-page-en { font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif; }
  h1, h2, h3 { font-family: inherit; letter-spacing: normal; word-break: keep-all; overflow-wrap: anywhere; }
  .menu-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .menu-title { margin: 0; line-height: 0; }
  .menu-title a { display: inline-block; }
  .menu-title img { display: block; width: 228px; max-width: 100%; height: auto; }
  .menu-tagline { margin: 14px 0 28px; color: #66736a; font-size: .875rem; letter-spacing: .02em; }
  a:focus-visible { outline: 2px solid #254536; outline-offset: 3px; }
  .language-nav { display: flex; gap: 3px; padding: 3px; background: #f0f3ee; border-radius: 999px; }
  .language-nav a { display: flex; align-items: center; justify-content: center; min-width: 72px; min-height: 44px; padding: 8px 10px; border-radius: 999px; color: #405348; font-size: .8125rem; }
  .language-nav a[aria-current="page"] { background: #254536; color: #fff; font-weight: 700; }
  .menu-nav { position: sticky; top: 0; z-index: 10; display: flex; gap: 6px; overflow-x: auto; padding: 10px 0 12px; margin-bottom: 30px; background: #fff; border-bottom: 1px solid #dce5dd; scrollbar-width: none; }
  .menu-nav::-webkit-scrollbar { display: none; }
  .menu-nav a { display: flex; flex: 1 0 auto; align-items: center; justify-content: center; min-height: 44px; padding: 9px 12px; border-radius: 999px; background: #f3f5f1; color: #315042; font-size: .875rem; font-weight: 600; white-space: nowrap; }
  .menu-nav a:hover, .menu-nav a:focus-visible { background: #e6eee6; }
  .menu-nav a[aria-current="location"] { background: #254536; color: #fff; }
  .menu-section { scroll-margin-top: 90px; }
  .menu-section + .menu-section { margin-top: 48px; }
  .decaf-note, .section-note { margin: 12px 0 10px; padding: 11px 14px; background: #eef4ed; color: #254536; border-left: 3px solid #254536; border-radius: 4px; font-size: .875rem; line-height: 1.55; }
  .coffee-options { margin-top: 24px; padding: 18px 20px; background: #f5f7f4; border-radius: 10px; }
  .coffee-options h3 { margin-bottom: 4px; font-size: 1rem; }
  .coffee-options .option:last-child { border-bottom: 0; padding-bottom: 0; }
  .temperature { margin: 6px 0 0; }
  .temperature span { display: inline-block; padding: 1px 6px; border: 1px solid #e2c9c3; border-radius: 3px; font-size: .75rem; font-weight: 600; color: #89443b; }
  @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }
  h2 { margin: 0; padding-bottom: 12px; border-bottom: 2px solid #254536; color: #254536; font-size: 1.5rem; font-weight: 700; line-height: 1.4; }
  ul, dl { list-style: none; margin: 0; padding: 0; }
  li, .option { padding: 15px 0; border-bottom: 1px solid #e7ece6; }
  li.featured-item { margin: 12px 0; padding: 14px 16px; background: #f5f8f3; border: 1px solid #dbe7d9; border-radius: 10px; }
  .menu-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: start; }
  .option { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 16px; align-items: start; }
  .option .detail { grid-column: 1 / -1; }
  h3, dt { margin: 0; font-size: 1.0625rem; font-weight: 700; line-height: 1.5; }
  .new-badge { display: inline-block; margin-left: 8px; padding: 2px 6px; border-radius: 4px; background: #254536; color: #fff; font-size: .6875rem; font-weight: 700; line-height: 1.4; vertical-align: 2px; }
  dt { word-break: keep-all; overflow-wrap: anywhere; }
  dd { margin: 0; }
  .price { color: #1d2c24; font-size: 1.0625rem; font-weight: 700; line-height: 1.5; font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
  .detail { margin: 5px 0 0; color: #5b665d; font-size: .875rem; line-height: 1.6; word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    :global(body) { background: #fff; }
    .menu-page { padding: 24px 16px 56px; box-shadow: none; }
    .menu-title img { width: clamp(145px, 44vw, 190px); }
    .language-nav a { min-width: 62px; }
    .menu-tagline { margin-bottom: 18px; }
    .menu-nav { margin-inline: -16px; padding-inline: 16px; }
    .menu-nav a { flex: 0 0 auto; }
    .menu-section + .menu-section { margin-top: 40px; }
    .menu-row, .option { gap: 10px; }
  }
  @media print { .menu-nav, .language-nav { display: none; } .menu-page { max-width: none; padding: 0; box-shadow: none; } li, .option { break-inside: avoid; } }
</style>
