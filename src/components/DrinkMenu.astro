---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMenu, languages, type MenuLocale } from '../lib/menu';
interface Props { locale: MenuLocale }
const { locale } = Astro.props;
const language = languages.find(language => language.code === locale)!;
const { copy, sections, options, decafPrice, formatPrice } = getMenu(locale);
---
<BaseLayout title={copy.title} description={copy.description} lang={language.tag}>
  <Fragment slot="head">
    {languages.map(language => <link rel="alternate" hreflang={language.tag} href={'https://marketmay.com' + language.href} />)}
    <link rel="alternate" hreflang="x-default" href="https://marketmay.com/menu/" />
  </Fragment>
  <main class="menu-page">
    <h1><a href="/">{copy.title}</a></h1>
    <nav class="language-nav" aria-label={copy.languageLabel}>
      {languages.map(language => (
        <a href={language.href} lang={language.tag} hreflang={language.tag} aria-current={language.code === locale ? 'page' : undefined}>{language.label}</a>
      ))}
    </nav>
    {copy.currency && <p class="currency-note">{copy.currency}</p>}
    <nav class="menu-nav" aria-label={copy.navLabel}>
      {sections.map(section => <a href={'#' + section.id} aria-label={section.name}>{section.nav}</a>)}
    </nav>
    {sections.map(section => (
      <section id={section.id} aria-labelledby={'heading-' + section.id}>
        <h2 id={'heading-' + section.id}>{section.name}</h2>
        {section.id === 'coffee' && decafPrice !== undefined && (
          <p class="decaf-note">{copy.decaf} · <strong>{decafPrice === 0 ? copy.freeChange : '+' + formatPrice(decafPrice)}</strong></p>
        )}
        <ul>
          {section.items.map(item => (
            <li data-menu-id={item.id}>
              <div class="menu-row"><h3>{item.name}</h3><span class="price">{formatPrice(item.price)}</span></div>
              {item.hotOnly && <p class="temperature"><span>{copy.hotOnly}</span></p>}
              {item.detail && <p class="detail">{item.detail}</p>}
            </li>
          ))}
        </ul>
        {section.id === 'coffee' && (
          <div class="coffee-options" id="options" aria-labelledby="options-heading">
            <h3 id="options-heading">{copy.optionsTitle}</h3>
            <dl>{options.map(option => (
              <div class="option">
                <dt>{option.name}</dt>
                <dd class="price">{option.price === 0 ? copy.free : (option.refill ? '' : '+') + formatPrice(option.price)}</dd>
                {option.detail && <dd class="detail">{option.detail}</dd>}
              </div>
            ))}</dl>
          </div>
        )}
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #fff;
    color: #171717;
    font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  .menu-page { max-width: 42rem; margin: 0 auto; padding: 28px 20px 48px; }
  h1, h2, h3 { font-family: inherit; letter-spacing: normal; word-break: keep-all; overflow-wrap: anywhere; }
  h1 { margin: 0 0 12px; font-size: 1.5rem; font-weight: 700; line-height: 1.4; }
  a:focus-visible { outline: 2px solid #171717; outline-offset: 5px; }
  .language-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; width: min(100%, 20rem); margin: 0 0 8px; }
  .language-nav a { display: flex; align-items: center; justify-content: center; min-height: 44px; border: 1px solid #e0e5e0; border-radius: 6px; font-size: .875rem; }
  .language-nav a[aria-current="page"] { background: #254536; color: #fff; border-color: #254536; font-weight: 700; }
  .currency-note { color: #555; font-size: .8125rem; margin: 4px 0 8px; }
  .menu-nav { position: sticky; top: 0; z-index: 10; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2px; padding: 8px 0; margin-bottom: 24px; background: #fff; border-bottom: 1px solid #dce3dc; }
  .menu-nav a { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 4px; border-radius: 6px; font-size: 1rem; font-weight: 600; color: #254536; }
  .menu-nav a:hover, .menu-nav a:focus-visible { background: #edf2ed; }
  section { scroll-margin-top: 84px; }
  section + section { margin-top: 36px; }
  .decaf-note { margin: 12px 0 4px; color: #254536; font-size: .9375rem; }
  .coffee-options { margin-top: 20px; padding: 16px; background: #f5f7f4; border-radius: 8px; }
  .coffee-options h3 { margin-bottom: 4px; font-size: 1rem; }
  .coffee-options .option:last-child { border-bottom: 0; padding-bottom: 0; }
  .temperature { margin: 6px 0 0 8px; }
  .temperature span { display: inline-block; padding: 1px 6px; border: 1px solid #e2c9c3; border-radius: 3px; font-size: .75rem; font-weight: 600; color: #89443b; }
  @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }
  h2 { margin: 0; padding-bottom: 10px; border-bottom: 1px solid #333; font-size: 1.25rem; font-weight: 700; line-height: 1.5; }
  ul, dl { list-style: none; margin: 0; padding: 0; }
  li, .option { padding: 14px 0; border-bottom: 1px solid #e7e7e7; }
  .menu-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: baseline; }
  .option { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 16px; align-items: baseline; }
  .option .detail { grid-column: 1 / -1; }
  h3, dt { margin: 0; font-size: 1.125rem; font-weight: 650; line-height: 1.55; }
  dt { word-break: keep-all; overflow-wrap: anywhere; }
  dd { margin: 0; }
  .price { font-size: 1.125rem; font-weight: 600; line-height: 1.55; font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
  .detail { margin: 6px 0 0 8px; font-weight: 400; color: #555; font-size: .9375rem; line-height: 1.6; word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 360px) { .menu-page { padding-inline: 16px; } .menu-row { gap: 12px; } }
  @media print { .menu-nav, .language-nav { display: none; } .menu-page { max-width: none; padding: 0; } li, .option { break-inside: avoid; } }
</style>
