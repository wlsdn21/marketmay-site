---
import type { MenuCategory, MenuItem } from '../lib/data';
interface Props { category: MenuCategory }
const { category } = Astro.props;

interface Group {
  baseName: string;
  hot?: MenuItem;
  iced?: MenuItem;
  description?: string;
}

/**
 * POS 데이터 컨벤션:
 *   "(I)" 접두사 = 아이스 변형
 *   접두사 없음 = 핫 (또는 단일 온도 메뉴)
 *
 * baseNameOf("(I)아메리카노") -> { base: "아메리카노", isIced: true }
 * baseNameOf("아메리카노")    -> { base: "아메리카노", isIced: false }
 */
function baseNameOf(name: string): { base: string; isIced: boolean } {
  const trimmed = name.trim();
  if (trimmed.startsWith('(I)')) {
    return { base: trimmed.slice(3).trim(), isIced: true };
  }
  return { base: trimmed, isIced: false };
}

function groupItems(items: MenuItem[]): Group[] {
  const map = new Map<string, Group>();
  const order: string[] = []; // 첫 등장 순서 보존
  for (const item of items) {
    const { base, isIced } = baseNameOf(item.name);
    if (!map.has(base)) {
      map.set(base, { baseName: base });
      order.push(base);
    }
    const group = map.get(base)!;
    if (isIced) group.iced = item;
    else group.hot = item;
    if (item.description) group.description = item.description;
  }
  return order.map(b => map.get(b)!);
}

const groups = groupItems(category.items);
---
<section class="menu-section">
  <h2 class="menu-cat">{category.name}</h2>
  {category.note && <p class="menu-cat-note">{category.note}</p>}
  {groups.length === 0 ? (
    <p class="menu-empty">메뉴 준비 중입니다.</p>
  ) : (
    <ul class="menu-list">
      {groups.map((g) => (
        <li class="menu-item">
          <div class="menu-item-head">
            <span class="menu-item-name">{g.baseName}</span>
            <span class="menu-item-dots"></span>
            <span class="menu-item-price">
              {g.hot && g.iced ? (
                // 양쪽 다 있으면 라벨 없이 단일 가격 (가격 다르면 hot 기준)
                <span class="price-num">{g.hot.price.toLocaleString()}</span>
              ) : g.hot ? (
                <>
                  <span class="price-num">{g.hot.price.toLocaleString()}</span>
                  {g.hot.onlyHot && <span class="badge subtle">only hot</span>}
                </>
              ) : (
                <>
                  <span class="price-num">{g.iced!.price.toLocaleString()}</span>
                  {g.iced!.onlyIced && <span class="badge subtle">only iced</span>}
                </>
              )}
            </span>
          </div>
          {g.description && <p class="menu-item-desc">{g.description}</p>}
        </li>
      ))}
    </ul>
  )}
</section>

<style>
.menu-section {
  padding: 40px 0;
  border-bottom: 1px solid var(--border);
}
.menu-section:last-child { border-bottom: 0; }
.menu-cat {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 500;
  color: var(--brand);
  margin-bottom: 6px;
}
.menu-cat-note {
  font-size: 12px;
  color: var(--text-mute);
  letter-spacing: 0.5px;
  margin: 0 0 22px;
}
.menu-empty {
  color: var(--text-mute);
  font-size: 14px;
  font-style: italic;
}
.menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.menu-item {
  padding: 12px 0;
}
.menu-item-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-size: 15px;
}
.menu-item-name { font-weight: 500; }
.menu-item-dots {
  flex: 1;
  border-bottom: 1px dotted var(--border);
  transform: translateY(-4px);
  min-width: 24px;
}
.menu-item-price {
  color: var(--text-mute);
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.price-num { font-variant-numeric: tabular-nums; }
.price-num::after { content: '원'; opacity: 0.55; margin-left: 1px; }
.badge {
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: 600;
  color: var(--brand);
  text-transform: uppercase;
}
.badge.subtle {
  color: var(--text-mute);
  opacity: 0.85;
}
.sep {
  opacity: 0.4;
  padding: 0 2px;
}
.menu-item-desc {
  font-size: 13px;
  color: var(--text-mute);
  margin: 4px 0 0;
}
@media (max-width: 480px) {
  .menu-item-head { font-size: 14px; }
  .badge { font-size: 9px; }
}
</style>
