---
import type { MenuCategory, MenuItem, MenuEntry } from '../lib/data';
import { isHeading } from '../lib/data';
interface Props { category: MenuCategory; sectionId?: string }
const { category, sectionId } = Astro.props;

interface Group {
  baseName: string;
  hot?: MenuItem;
  iced?: MenuItem;
  description?: string;
}

type Row =
  | { kind: 'heading'; heading: string }
  | { kind: 'group'; group: Group };

/**
 * POS 데이터 컨벤션:
 *   "(I)" 접두사 = 아이스 변형
 *   접두사 없음 = 핫 (또는 단일 온도 메뉴)
 */
function baseNameOf(name: string): { base: string; isIced: boolean } {
  const trimmed = name.trim();
  if (trimmed.startsWith('(I)')) {
    return { base: trimmed.slice(3).trim(), isIced: true };
  }
  return { base: trimmed, isIced: false };
}

/** 한 chunk(헤딩 사이의 항목들) 안에서 hot/iced를 base name으로 묶는다. */
function groupChunk(items: MenuItem[]): Group[] {
  const map = new Map<string, Group>();
  const order: string[] = [];
  for (const item of items) {
    const { base, isIced } = baseNameOf(item.name);
    if (!map.has(base)) {
      map.set(base, { baseName: base });
      order.push(base);
    }
    const group = map.get(base)!;
    if (isIced) group.iced = item;
    else group.hot = item;
    if (item.description) group.description = item.description;
  }
  return order.map(b => map.get(b)!);
}

/** 헤딩과 항목이 섞인 entries 리스트를 렌더용 Row[] 로 변환. */
function buildRows(entries: MenuEntry[]): Row[] {
  const rows: Row[] = [];
  let chunk: MenuItem[] = [];

  const flush = () => {
    if (chunk.length === 0) return;
    for (const g of groupChunk(chunk)) rows.push({ kind: 'group', group: g });
    chunk = [];
  };

  for (const entry of entries) {
    if (isHeading(entry)) {
      flush();
      rows.push({ kind: 'heading', heading: entry.heading });
    } else {
      chunk.push(entry);
    }
  }
  flush();
  return rows;
}

const rows = buildRows(category.items);
---
<section class="menu-section" id={sectionId}>
  <h2 class="menu-cat">{category.name}</h2>
  {category.note && <p class="menu-cat-note">{category.note}</p>}
  {rows.length === 0 ? (
    <p class="menu-empty">메뉴 준비 중입니다.</p>
  ) : (
    <ul class="menu-list">
      {rows.map((row) => row.kind === 'heading' ? (
        <li class="menu-subheading"><span>{row.heading}</span></li>
      ) : (
        <li class="menu-item">
          <div class="menu-item-head">
            <span class="menu-item-name">{row.group.baseName}</span>
            <span class="menu-item-dots"></span>
            <span class="menu-item-price">
              {(() => {
                // 양쪽 다 있든, 한쪽만 있든, 가격 표시는 hot 우선 (없으면 iced)
                const it = (row.group.hot ?? row.group.iced)!;
                const badge =
                  !(row.group.hot && row.group.iced) && it.onlyHot
                    ? 'only hot'
                    : !(row.group.hot && row.group.iced) && it.onlyIced
                      ? 'only iced'
                      : null;
                return (
                  <>
                    {it.variants ? (
                      it.variants.map((v, i) => (
                        <>
                          {i > 0 && <span class="sep">·</span>}
                          <span class="size-label">{v.label}</span>
                          <span class="price-num">{v.price.toLocaleString()}</span>
                        </>
                      ))
                    ) : (
                      <span class="price-num">{it.price!.toLocaleString()}</span>
                    )}
                    {badge && <span class="badge subtle">{badge}</span>}
                  </>
                );
              })()}
            </span>
          </div>
          {row.group.description && <p class="menu-item-desc">{row.group.description}</p>}
        </li>
      ))}
    </ul>
  )}
</section>

<style>
.menu-section {
  padding: 40px 0;
  border-bottom: 1px solid var(--border);
  scroll-margin-top: 132px; /* sticky header(~60) + 카테고리 탭(~72) */
}
.menu-section:last-child { border-bottom: 0; }
.menu-cat {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 500;
  color: var(--brand);
  margin-bottom: 6px;
}
.menu-cat-note {
  font-size: 12px;
  color: var(--text-mute);
  letter-spacing: 0.5px;
  margin: 0 0 22px;
}
.menu-empty {
  color: var(--text-mute);
  font-size: 14px;
  font-style: italic;
}
.menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.menu-subheading {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 24px 0 8px;
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--brand);
  font-weight: 600;
}
.menu-subheading::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--border);
}
.menu-list .menu-subheading:first-child {
  padding-top: 0;
}
.menu-item {
  padding: 12px 0;
}
.menu-item-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-size: 15px;
}
.menu-item-name { font-weight: 500; }
.menu-item-dots {
  flex: 1;
  border-bottom: 1px dotted var(--border);
  transform: translateY(-4px);
  min-width: 24px;
}
.menu-item-price {
  color: var(--text-mute);
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.price-num { font-variant-numeric: tabular-nums; }
.price-num::after { content: '원'; opacity: 0.55; margin-left: 1px; }
.badge {
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: 600;
  color: var(--brand);
  text-transform: uppercase;
}
.badge.subtle {
  color: var(--text-mute);
  opacity: 0.85;
}
.size-label {
  font-size: 11px;
  letter-spacing: 1px;
  color: var(--brand);
  font-weight: 600;
  margin-right: 2px;
}
.sep {
  opacity: 0.4;
  padding: 0 2px;
}
.menu-item-desc {
  font-size: 13px;
  color: var(--text-mute);
  margin: 4px 0 0;
}
@media (max-width: 480px) {
  .menu-item-head { font-size: 14px; }
  .badge { font-size: 9px; }
}
</style>
