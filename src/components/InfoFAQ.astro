---
// 매장 소개 + 자주 묻는 질문(FAQ) — AI·검색이 읽기 좋은 텍스트 + FAQPage 구조화데이터.
// 내용은 src/data/info.yaml 의 amenities / seasonal / faq 에서 편집.
import { info } from '../lib/data';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: info.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<section class="info-faq">
  <div class="container">
    <h2 class="info-faq-title">about &amp; faq</h2>

    <p class="info-about">
      마켓메이(market may)는 구미 금오산 공원로에 자리한 카페입니다.
      창가에서 풍경을 바라보며 직접 볶은 커피와 빵, 브런치를 즐겨보세요.
      친구와 이야기를 나누는 날에도, 가족과 금오산 나들이를 나온 날에도 편하게 쉬어가세요.
      영업시간은 {info.hours.weekday}이며, {info.hours.closed}입니다.
      브런치는 오후 3시까지 주문하실 수 있습니다.
    </p>

    <dl class="faq-list">
      {info.faq.map((item) => (
        <div class="faq-item">
          <dt class="faq-q">{item.q}</dt>
          <dd class="faq-a">{item.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<style>
.info-faq {
  padding: var(--space-section) 0;
  background: var(--bg);
}
.info-faq-title {
  font-family: var(--font-heading);
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 500;
  text-align: center;
  color: var(--brand);
  margin-bottom: 28px;
}
.info-about {
  max-width: 640px;
  margin: 0 auto 44px;
  text-align: center;
  font-size: 15px;
  line-height: 1.9;
  color: var(--text-mute);
}
.faq-list {
  max-width: 640px;
  margin: 0 auto;
  padding: 0;
}
.faq-item {
  padding: 18px 2px;
  border-top: 1px solid var(--border);
}
.faq-item:last-child { border-bottom: 1px solid var(--border); }
.faq-q {
  font-weight: 600;
  font-size: 15px;
  color: var(--text);
  margin-bottom: 6px;
}
.faq-q::before {
  content: 'Q. ';
  color: var(--brand);
  font-family: var(--font-heading);
  font-weight: 600;
}
.faq-a {
  margin: 0;
  font-size: 14px;
  line-height: 1.7;
  color: var(--text-mute);
}
</style>
