---
import { info } from '../lib/data';
---
<section class="floors">
  <div class="container">
    <h2 class="floors-title">three spaces</h2>
    <p class="floors-subtitle">한 건물, 세 가지 공간</p>
    <div class="floors-grid">
      {info.floors.map((floor) => (
        <article class="floor">
          <div class="floor-code">{floor.code}</div>
          <div class="floor-name">{floor.name}</div>
          <p class="floor-desc">{floor.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.floors {
  padding: var(--space-section) 0;
  background: var(--bg);
}
.floors-title {
  font-family: var(--font-heading);
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 500;
  text-align: center;
  color: var(--brand);
  margin-bottom: 8px;
}
.floors-subtitle {
  text-align: center;
  color: var(--text-mute);
  font-size: 14px;
  margin: 0 0 48px;
}
.floors-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.floor {
  text-align: center;
  padding: 32px 24px;
  border: 1px solid var(--border);
  background: #fff;
}
.floor-code {
  font-family: var(--font-heading);
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--brand);
  margin-bottom: 12px;
}
.floor-name {
  font-family: var(--font-heading);
  font-size: 24px;
  margin-bottom: 12px;
  letter-spacing: 2px;
}
.floor-desc {
  font-size: 14px;
  color: var(--text-mute);
  line-height: 1.6;
  margin: 0;
}
@media (max-width: 720px) {
  .floors-grid { grid-template-columns: 1fr; gap: 16px; }
}
</style>
