---
import { info } from '../lib/data';
---
<footer class="footer">
  <div class="container footer-inner">
    <span class="copy">© 2026 {info.name}</span>
    <a class="ig" href={info.instagram} target="_blank" rel="noopener">@market.may_</a>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--border);
  background: var(--bg);
  padding: 32px 0;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--text-mute);
}
.ig:hover { color: var(--brand); }
@media (max-width: 480px) {
  .footer-inner { flex-direction: column; gap: 12px; }
}
</style>
