---
import { notice } from '../lib/data';
import { getMenu } from '../lib/menu';

const version = notice.version ?? 1;
const { sections, formatPrice } = getMenu('ko');
const brunchItems = sections.find(section => section.id === 'brunch')?.items ?? [];
const featuredItems = (notice.featuredMenuIds ?? [])
  .map(id => brunchItems.find(item => item.id === id))
  .filter((item): item is (typeof brunchItems)[number] => item !== undefined);
const featuredPhotos = featuredItems.filter(item => notice.featuredImages?.[item.id]);
const show = notice.enabled && Boolean(notice.image || notice.title || featuredItems.length);
const hasButton = Boolean(notice.button?.url && notice.button?.label);
---
{show && (
  <dialog class="notice-dialog" data-version={version} aria-label={notice.title || '마켓메이 소식'}>
    <div class="notice-topbar">
      <img src="/images/market-may-menu-logo.png" alt="마켓메이" width="1800" height="400" />
      <button class="notice-close" type="button" aria-label="팝업 닫기">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </div>

    {notice.image && (
      <figure class="notice-photo">
        <img src={notice.image} alt={notice.imageAlt ?? ''} width="1600" height="1200" loading="eager" decoding="async" />
        {notice.imageNote && <figcaption>{notice.imageNote}</figcaption>}
      </figure>
    )}
    {featuredPhotos.length > 0 && (
      <figure class="notice-photo-grid">
        {featuredPhotos.map(item => (
          <img
            src={notice.featuredImages![item.id]}
            alt={`${item.name} 포스터`}
            width={item.id === 'chili-egg' ? '1080' : '1122'}
            height={item.id === 'chili-egg' ? '1350' : '1402'}
            loading="eager"
            decoding="async"
          />
        ))}
        {notice.imageNote && <figcaption>{notice.imageNote}</figcaption>}
      </figure>
    )}

    <div class="notice-content">
      {notice.title && <h2>{notice.title}</h2>}
      {notice.body && <p class="notice-body">{notice.body}</p>}
      {featuredItems.length > 0 && (
        <ul class="notice-menu-list">
          {featuredItems.map(item => (
            <li>
              <span>{item.name}</span>
              <strong>{formatPrice(item.price)}</strong>
            </li>
          ))}
        </ul>
      )}
      {hasButton && <a class="notice-link" href={notice.button!.url}>{notice.button!.label}</a>}
    </div>

    <label class="notice-dismiss">
      <input type="checkbox" class="notice-dismiss-check" />
      <span>오늘 하루 보지 않기</span>
    </label>
  </dialog>
)}

<script>
  import { shouldShowNotice, dismissValue, dateKey } from '../lib/notice-visibility';

  const dialog = document.querySelector<HTMLDialogElement>('.notice-dialog');
  if (dialog) {
    const closeButton = dialog.querySelector<HTMLButtonElement>('.notice-close');
    const dismissCheck = dialog.querySelector<HTMLInputElement>('.notice-dismiss-check');
    const version = Number(dialog.dataset.version) || 1;
    const today = dateKey(new Date());
    const storageKey = 'mm-notice-dismissed';
    let stored: string | null = null;
    try { stored = localStorage.getItem(storageKey); } catch { /* Storage may be disabled. */ }

    if (shouldShowNotice(stored, version, today)) dialog.showModal();

    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (!dismissCheck?.checked) return;
      try { localStorage.setItem(storageKey, dismissValue(version, today)); } catch { /* Storage may be disabled. */ }
    });
  }
</script>

<style>
  .notice-dialog {
    width: min(480px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: #fff;
    color: #25372d;
    box-shadow: 0 18px 48px rgba(13, 32, 19, .22);
    overflow-y: auto;
  }
  .notice-dialog::backdrop { background: rgba(13, 25, 17, .62); }
  .notice-topbar { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 6px 16px 6px 24px; }
  .notice-topbar img { width: 112px; height: auto; }
  .notice-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #edf1ed;
    color: #25372d;
    cursor: pointer;
  }
  .notice-close svg { width: 19px; height: 19px; }
  .notice-close:hover { background: #dfe9df; }
  .notice-close:focus-visible, .notice-link:focus-visible, .notice-dismiss-check:focus-visible { outline: 3px solid #9ac79c; outline-offset: 3px; }
  .notice-photo { margin: 0; }
  .notice-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: min(34dvh, 260px);
    object-fit: cover;
    object-position: center;
  }
  .notice-photo figcaption { padding: 8px 24px 0; color: #59695e; font-size: 12px; line-height: 1.4; }
  .notice-photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; margin: 0; }
  .notice-photo-grid img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: contain; }
  .notice-photo-grid figcaption { grid-column: 1 / -1; padding: 6px 24px 0; color: #59695e; font-size: 12px; line-height: 1.4; }
  .notice-content { padding: 18px 24px 24px; }
  .notice-content h2 { margin: 0; color: #25372d; font-family: var(--font-body); font-size: 1.5rem; font-weight: 700; line-height: 1.3; word-break: keep-all; }
  .notice-content h2 + .notice-menu-list { margin-top: 18px; }
  .notice-body { margin: 8px 0 18px; color: #59695e; font-size: .9375rem; line-height: 1.5; }
  .notice-menu-list { list-style: none; margin: 0 0 22px; padding: 0; border-top: 1px solid #e2e8e1; }
  .notice-menu-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 12px; padding: 12px 0; border-bottom: 1px solid #e2e8e1; font-size: .9375rem; line-height: 1.5; }
  .notice-menu-list li span { font-weight: 600; word-break: keep-all; }
  .notice-menu-list li strong { font-size: .9375rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .notice-link { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 11px 16px; border-radius: 8px; background: #254536; color: #fff; font-size: .9375rem; font-weight: 700; line-height: 1.4; text-align: center; }
  .notice-link:hover { background: #173325; }
  .notice-dismiss { display: flex; align-items: center; gap: 9px; min-height: 50px; padding: 10px 24px; border-top: 1px solid #e2e8e1; color: #47594d; font-size: .875rem; cursor: pointer; }
  .notice-dismiss-check { width: 17px; height: 17px; margin: 0; accent-color: #254536; cursor: pointer; }
  @media (max-width: 390px) {
    .notice-content { padding-inline: 20px; }
    .notice-photo figcaption { padding-inline: 20px; }
    .notice-photo-grid figcaption { padding-inline: 20px; }
    .notice-dismiss { padding-inline: 20px; }
  }
  @media (max-width: 420px) and (max-height: 600px) {
    .notice-photo img { max-height: 28dvh; }
    .notice-content { padding-top: 14px; padding-bottom: 16px; }
    .notice-menu-list { margin-bottom: 16px; }
  }
</style>
