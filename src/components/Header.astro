---
import { info } from '../lib/data';
---
<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand">{info.name}</a>
    <nav class="nav">
      {/* menu 페이지 숨김(나중에 복구 시 주석 해제): <a href="/menu">menu</a> */}
      <a href={info.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
        </svg>
      </a>
      <a href="#location" class="cta">오시는 길</a>
    </nav>
  </div>
</header>

<style>
.header {
  border-bottom: 1px solid var(--border);
  background: var(--bg);
  position: sticky;
  top: 0;
  z-index: 10;
}
.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
}
.brand {
  font-family: var(--font-heading);
  font-size: 22px;
  letter-spacing: 0.5px;
}
.nav {
  display: flex;
  gap: 24px;
  align-items: center;
  font-size: 14px;
}
.nav a {
  color: var(--text-mute);
  transition: color 0.15s;
}
.nav a:hover { color: var(--text); }
.icon-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.icon-link svg { width: 19px; height: 19px; display: block; }
.icon-link:hover { color: var(--brand); }
.cta {
  background: var(--brand);
  color: #fff !important;
  padding: 8px 14px;
  border-radius: 4px;
}
.cta:hover { color: #fff !important; opacity: 0.9; }
@media (max-width: 480px) {
  .nav { gap: 14px; }
  .nav a { font-size: 13px; }
}
</style>
