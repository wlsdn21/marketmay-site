---
const images = [
  { src: '/images/interior-1.jpg', alt: '창가 좌석' },
  { src: '/images/interior-2.jpg', alt: '내부 라운지' },
  { src: '/images/menu-display.jpg', alt: '베이글과 빵' },
];
---
<section class="gallery">
  <div class="gallery-grid">
    {images.map((img) => (
      <figure class="gallery-cell">
        <img
          src={img.src}
          alt={img.alt}
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </div>
</section>

<style>
.gallery {
  background: var(--bg-alt);
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}
.gallery-cell {
  margin: 0;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}
.gallery-cell img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
@media (max-width: 720px) {
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-cell { aspect-ratio: 4 / 3; }
}
</style>
