---
const images = [
  // Official @market.may_ posts: DdmP-8VRut0, Ddj0Bb3Txr2, DWFwG7AjxjU.
  { src: '/images/instagram-daily-baking.jpg', alt: '당일 구운 빵을 포장하는 마켓메이 베이커리', width: 512, height: 640, position: 'top' },
  { src: '/images/instagram-chili-eggs.jpg', alt: '사워도우와 달걀을 곁들인 칠리 에그', width: 512, height: 640, position: 'bottom' },
  { src: '/images/instagram-passion-fruit.jpg', alt: '백향과를 직접 손질하는 모습', width: 480, height: 640, position: 'center' },
];
---
<section class="gallery">
  <div class="gallery-grid">
    {images.map((img) => (
      <figure class="gallery-cell">
        <img
          src={img.src}
          alt={img.alt}
          width={img.width}
          height={img.height}
          class={img.position}
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </div>
</section>

<style>
.gallery {
  background: var(--bg-alt);
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}
.gallery-cell {
  margin: 0;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}
.gallery-cell img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.gallery-cell img.top { object-position: center top; }
.gallery-cell img.bottom { object-position: center bottom; }
@media (max-width: 720px) {
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-cell { aspect-ratio: 4 / 3; }
}
</style>
