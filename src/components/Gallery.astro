---
import { info, isHeading, menu } from '../lib/data';
import type { MenuItem } from '../lib/data';

const brunch = menu.categories.find((category) => category.name === '브런치');
if (!brunch) throw new Error('홈 갤러리에 필요한 브런치 메뉴가 없습니다.');
const brunchItems = brunch.items.filter((item): item is MenuItem => !isHeading(item));
const [coffeeTitle, coffeeDescription] = info.tagline.split('\n');

// 메뉴판 순서의 플레이트와 베이글 사이에 커피 연출 이미지를 배치한다.
const featured = [
  { ...brunchItems[0], alt: brunchItems[0].name },
  {
    name: coffeeTitle,
    description: coffeeDescription,
    image: '/images/brunch/roasted-coffee.webp',
    alt: '초록 테두리 잔에 담긴 블랙커피와 볶은 원두 연출 이미지',
    price: undefined,
  },
  { ...brunchItems[2], alt: brunchItems[2].name },
];
const formatPrice = (price: number) => `${price.toLocaleString('ko-KR')}원`;
---
<section class="gallery" id="brunch" aria-label="커피와 브런치">
  <div class="gallery-grid">
    {featured.map((item) => (
      <figure class="gallery-cell">
        <div class="gallery-image">
          <img
            src={item.image}
            alt={item.alt}
            width="1200"
            height={item.price === undefined ? 1200 : 900}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span class="gallery-name">{item.name}</span>
          {item.price !== undefined && <span class="gallery-price">{formatPrice(item.price)}</span>}
          {item.description && <span class="gallery-description">{item.description}</span>}
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="brunch-menu container">
    <p class="brunch-note">{brunch.note}</p>
    <details class="brunch-details">
      <summary>
        <span class="when-closed">브런치 메뉴 전체 보기</span>
        <span class="when-open">브런치 메뉴 접기</span>
      </summary>
      <div class="brunch-content">
        <h2>Brunch Menu</h2>
        <ul class="brunch-grid">
          {brunchItems.map((item) => (
            <li>
              <figure>
                <img
                  src={item.image}
                  alt={item.name}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  <span class="brunch-name">{item.name}</span>
                  {item.price !== undefined && <span class="gallery-price">{formatPrice(item.price)}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>
</section>

<style>
.gallery {
  background: var(--bg);
  scroll-margin-top: 88px;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
}
.gallery-cell { margin: 0; min-width: 0; }
.gallery-image {
  aspect-ratio: 1;
  overflow: hidden;
  background: #f6f6f4;
  display: flex;
  align-items: center;
}
.gallery-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.gallery-cell figcaption {
  padding: 20px 18px 22px;
  min-height: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  text-align: center;
}
.gallery-name, .brunch-name {
  font-size: 16px;
  font-weight: 600;
  word-break: keep-all;
}
.gallery-name { color: var(--brand); }
.gallery-price {
  font-size: 14px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  color: var(--text-mute);
}
.gallery-description {
  color: var(--text-mute);
  font-size: 13px;
  word-break: keep-all;
}
.brunch-menu { padding-top: 8px; padding-bottom: 28px; }
.brunch-note {
  text-align: center;
  font-size: 14px;
  color: var(--text-mute);
  word-break: keep-all;
  margin: 0 0 14px;
}
.brunch-details summary {
  width: fit-content;
  max-width: 100%;
  margin: 0 auto;
  padding: 12px 20px;
  border: 1px solid var(--brand);
  border-radius: 2px;
  color: var(--brand);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  list-style-position: inside;
}
.brunch-details summary:hover { background: #edf1ec; }
.brunch-details summary:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 4px;
}
.when-open, .brunch-details[open] .when-closed { display: none; }
.brunch-details[open] .when-open { display: inline; }
.brunch-content { padding-top: 40px; }
.brunch-content h2 {
  font-size: clamp(30px, 4vw, 42px);
  text-align: center;
  color: var(--brand);
  margin-bottom: 28px;
}
.brunch-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 32px 24px;
}
.brunch-grid li { min-width: 0; }
.brunch-grid figure { margin: 0; }
.brunch-grid img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: contain;
}
.brunch-grid figcaption {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px 16px;
  flex-wrap: wrap;
  padding: 14px 0 18px;
  border-bottom: 1px solid var(--border);
}
.brunch-name { font-size: 15px; }
@media (max-width: 720px) {
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-image { aspect-ratio: 4 / 3; }
  .gallery-cell figcaption { min-height: auto; padding: 18px 24px 26px; }
  .brunch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
}
@media (max-width: 420px) {
  .brunch-grid { grid-template-columns: 1fr; }
}
</style>
