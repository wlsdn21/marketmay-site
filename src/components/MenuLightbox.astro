---
// 메뉴 사진 라이트박스 — menu.astro에서만 사용
// .menu-item.has-photo[data-image] 클릭하면 열림
---
<div class="lb" id="menu-lb" role="dialog" aria-modal="true" aria-labelledby="lb-caption" aria-hidden="true">
  <button class="lb-close" type="button" aria-label="닫기">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="6" y1="6" x2="18" y2="18"/>
      <line x1="18" y1="6" x2="6" y2="18"/>
    </svg>
  </button>
  <figure class="lb-figure">
    <img class="lb-img" alt="" />
    <figcaption class="lb-caption" id="lb-caption"></figcaption>
  </figure>
</div>

<script is:inline>
(() => {
  const lb = document.getElementById('menu-lb');
  if (!lb) return;
  const img = lb.querySelector('.lb-img');
  const cap = lb.querySelector('.lb-caption');
  const closeBtn = lb.querySelector('.lb-close');
  let lastFocused = null;

  function open(src, name) {
    if (!src) return;
    img.src = src;
    img.alt = name || '';
    cap.textContent = name || '';
    lastFocused = document.activeElement;
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => closeBtn.focus());
  }
  function close() {
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    // 이미지는 약간의 지연 후 비워 transition을 자연스럽게
    setTimeout(() => { if (!lb.classList.contains('is-open')) { img.src = ''; } }, 200);
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }

  // 메뉴 항목 클릭 위임
  document.addEventListener('click', (e) => {
    const item = e.target.closest('.menu-item.has-photo[data-image]');
    if (!item) return;
    open(item.getAttribute('data-image'), item.getAttribute('data-name'));
  });
  // 키보드 (Enter / Space) — 클릭 가능한 메뉴 아이템 활성화
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const target = e.target;
    if (!target || !target.classList || !target.classList.contains('menu-item') || !target.classList.contains('has-photo')) return;
    e.preventDefault();
    open(target.getAttribute('data-image'), target.getAttribute('data-name'));
  });
  // 닫기: X 버튼, 배경 클릭, Esc
  closeBtn.addEventListener('click', close);
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lb.classList.contains('is-open')) close();
  });
})();
</script>

<style>
.lb {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
}
.lb.is-open {
  opacity: 1;
  pointer-events: auto;
}
.lb-figure {
  margin: 0;
  max-width: 92vw;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  transform: scale(0.8);
  opacity: 0;
  /* 닫힐 때: 빠른 페이드 + 작은 축소 */
  transition: transform 0.18s ease, opacity 0.18s ease;
}
.lb.is-open .lb-figure {
  transform: scale(1);
  opacity: 1;
  /* 열릴 때: 살짝 1을 넘었다가 안착 (back-out easing) */
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease-out;
}
.lb-img {
  max-width: 100%;
  max-height: 78vh;
  object-fit: contain;
  border-radius: 4px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  background: #fff;
}
.lb-caption {
  color: #fff;
  font-size: 14px;
  letter-spacing: 0.5px;
  text-align: center;
  opacity: 0.9;
}
.lb-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 40px;
  height: 40px;
  border: none;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.lb-close:hover { background: rgba(255, 255, 255, 0.18); }
.lb-close:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 2px;
}
.lb-close svg { width: 20px; height: 20px; }
@media (max-width: 480px) {
  .lb { padding: 12px; }
  .lb-close { top: 10px; right: 10px; width: 36px; height: 36px; }
  .lb-caption { font-size: 13px; }
}
</style>
