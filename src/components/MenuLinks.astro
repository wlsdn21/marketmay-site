---
// 홈 "메뉴 바로가기" 카드 — 누르면 메뉴 페이지의 해당 카테고리로 이동
import { info } from '../lib/data';
---
<section class="menu-links">
  <div class="container">
    <h2 class="menu-links-title">what we serve</h2>
    <p class="menu-links-subtitle">메뉴를 둘러보세요</p>
    <div class="menu-links-grid">
      {info.menuLinks.map((link) => (
        <a class="menu-link" href={link.href}>
          <div class="menu-link-name">{link.name}</div>
          <p class="menu-link-desc">{link.description}</p>
          <span class="menu-link-go">메뉴 보기 →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.menu-links {
  padding: var(--space-section) 0;
  background: var(--bg);
}
.menu-links-title {
  font-family: var(--font-heading);
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 500;
  text-align: center;
  color: var(--brand);
  margin-bottom: 8px;
}
.menu-links-subtitle {
  text-align: center;
  color: var(--text-mute);
  font-size: 14px;
  margin: 0 0 48px;
}
.menu-links-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.menu-link {
  display: block;
  text-align: center;
  padding: 36px 24px;
  border: 1px solid var(--border);
  background: #fff;
  color: inherit;
  text-decoration: none;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}
.menu-link:hover,
.menu-link:focus-visible {
  border-color: var(--brand);
  box-shadow: 0 8px 24px rgba(10, 55, 17, 0.08);
  transform: translateY(-2px);
  outline: none;
}
.menu-link-name {
  font-family: var(--font-heading);
  font-size: 26px;
  letter-spacing: 2px;
  color: var(--text);
  margin-bottom: 12px;
  transition: color 0.18s ease;
}
.menu-link:hover .menu-link-name,
.menu-link:focus-visible .menu-link-name {
  color: var(--brand);
}
.menu-link-desc {
  font-size: 14px;
  color: var(--text-mute);
  line-height: 1.6;
  margin: 0 0 16px;
}
.menu-link-go {
  display: inline-block;
  font-size: 12px;
  letter-spacing: 1px;
  color: var(--brand);
  opacity: 0.85;
  transition: opacity 0.18s ease, transform 0.18s ease;
}
.menu-link:hover .menu-link-go,
.menu-link:focus-visible .menu-link-go {
  opacity: 1;
  transform: translateX(2px);
}
@media (max-width: 720px) {
  .menu-links-grid { grid-template-columns: 1fr; gap: 16px; }
}
</style>
